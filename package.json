{
  "name": "generator-console-game",
  "version": "0.0.2",
  "description": "make a console game with fp-panel",
  "homepage": "https://github.com/afrontend",
  "author": {
    "name": "Bob Hwang",
    "email": "autoscripts@gmail.com",
    "url": "https://afrontend.github.io"
  },
  "files": [
    "app"
  ],
  "main": "generators/index.js",
  "keywords": [
    "yeoman-generator"
  ],
  "devDependencies": {
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^3.3.0",
    "eslint-config-xo": "^0.25.0",
    "eslint-plugin-prettier": "^3.0.0",
    "fp-panel": "^0.0.9",
    "husky": "^1.2.0",
    "jest": "^29.5.0",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "prettier": "^1.15.2",
    "yeoman-assert": "^3.1.0",
    "yeoman-test": "^11.3.1"
  },
  "engines": {
    "npm": ">= 4.0.0"
  },
  "dependencies": {
    "chalk": "^2.1.0",
    "yeoman-generator": "^8.1.2",
    "yosay": "^2.0.1"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  },
  "eslintConfig": {
    "extends": [
      "xo",
      "prettier"
    ],
    "env": {
      "jest": true,
      "node": true
    },
    "rules": {
      "prettier/prettier": "error"
    },
    "plugins": [
      "prettier"
    ]
  },
  "scripts": {
    "pretest": "eslint .",
    "test": "jest",
    "demo-gif": "bash scripts/make-demo.sh"
  },
  "repository": "https://github.com/afrontend/generator-console-game.git",
  "license": "MIT"
}
